import streamlit as st
import pandas as pd
import io
import openpyxl

st.set_page_config(
    page_title="7-ELEVEN 交貨便批次匯入檔 & 整理清單產生器",
    page_icon="📦",
    layout="wide"
)

st.title("📦 7-ELEVEN 交貨便批次匯入檔 & 整理清單產生器")
st.markdown("請上傳賣場／訂單匯出檔（支援 CSV 或 Excel），系統將自動產生 **「整理需求清單」** 與 **「7-11 交貨便批次匯入規格」** 兩個分頁。")

# 預設寄件人與退貨門市資訊 (可由使用者在 sidebar 彈性修改)
st.sidebar.header("⚙️ 預設寄件人與退貨門市設定")
sender_name = st.sidebar.text_input("寄件人姓名", value="吳涵羚")
sender_phone = st.sidebar.text_input("寄件人電話", value="0922935788")
sender_email = st.sidebar.text_input("寄件人 Email", value="yolozuya.makerstory@gmail.com")
parcel_val = st.sidebar.number_input("預設包裹價值 (元)", value=1000, step=100)
return_store_name = st.sidebar.text_input("退貨門市名稱", value="永吉門市")
return_store_code = st.sidebar.text_input("退貨門市店號", value="252975")

uploaded_file = st.file_uploader("📂 請上傳原始訂單檔案 (.csv, .xlsx, .xls)", type=["csv", "xlsx", "xls"])

if uploaded_file is not None:
    try:
        if uploaded_file.name.endswith('.csv'):
            df_raw = pd.read_csv(uploaded_file, dtype=str)
        else:
            df_raw = pd.read_excel(uploaded_file, dtype=str)
        
        st.success(f"成功讀取檔案：{uploaded_file.name} (共 {len(df_raw)} 筆資料)")
        
        st.subheader("1. 欄位對應確認")
        cols = df_raw.columns.tolist()
        
        c1, c2, c3, c4 = st.columns(4)
        with c1:
            col_name = st.selectbox("收件人姓名欄位", options=cols, index=0 if len(cols)>0 else 0)
            col_phone = st.selectbox("收件人電話欄位", options=cols, index=1 if len(cols)>1 else 0)
        with c2:
            col_email = st.selectbox("收件人 Email 欄位 (選填)", options=["無"] + cols, index=0)
            col_items = st.selectbox("購買商品/品項欄位", options=cols, index=2 if len(cols)>2 else 0)
        with c3:
            col_store_name = st.selectbox("收件門市名稱欄位", options=cols, index=3 if len(cols)>3 else 0)
            col_store_code = st.selectbox("收件門市店號欄位", options=cols, index=4 if len(cols)>4 else 0)
        with c4:
            col_order_id = st.selectbox("訂單編號/備註欄位 (選填)", options=["無"] + cols, index=0)
            col_val = st.selectbox("包裹價值欄位 (選填)", options=["無"] + cols, index=0)

        # 產生資料邏輯
        if st.button("🚀 立即產生兩分頁 Excel 清單", type="primary"):
            # --- 分頁 1: 整理需求清單 ---
            df_summary = pd.DataFrame()
            if col_order_id != "無":
                df_summary["訂單編號"] = df_raw[col_order_id]
            df_summary["收件人姓名"] = df_raw[col_name]
            df_summary["收件人電話"] = df_raw[col_phone]
            df_summary["收件門市"] = df_raw[col_store_name]
            df_summary["門市店號"] = df_raw[col_store_code]
            df_summary["訂購商品與數量"] = df_raw[col_items]
            if col_email != "無":
                df_summary["收件人 Email"] = df_raw[col_email]

            # --- 分頁 2: 7-11 交貨便批次匯入規格 ---
            wb = openpyxl.Workbook()
            
            # Sheet 1: 整理需求清單
            ws_sum = wb.active
            ws_sum.title = "整理需求清單"
            ws_sum.append(list(df_summary.columns))
            for r in df_summary.itertuples(index=False):
                ws_sum.append(list(r))
                
            # Sheet 2: 7-11 交貨便批次匯入規格
            ws_711 = wb.create_sheet(title="7-11交貨便批次匯入檔")
            
            # 7-11 官方第 1 列
            ws_711.append(["一般交貨便-取貨不付款(以下欄位皆必填)"])
            
            # 7-11 官方第 2 列: 欄位表頭
            header_2 = [
                None,
                "寄件人姓名",
                "寄件人電話",
                "寄件人mail",
                "實際包裏價值",
                "收件門市",
                "收件門市店號",
                "收件人姓名\n(請填寫證件姓名)",
                "收件人電話",
                "收件人mail",
                "退貨門市\n(非必填，退貨門市未填寫者，則依原寄件門市為退貨門市。此欄位有填寫者，退貨門市店號必填)",
                "退貨門市店號\n(非必填，退貨門市未填寫者，則依原寄件門市為退貨門市。此欄位有填寫者，退貨門市必填)"
            ]
            ws_711.append(header_2)
            
            # 7-11 官方第 3 列: 範例列
            sample_row = [
                "範例",
                "王小明",
                "0987654321",
                "xx@gmial.com",
                1200,
                "百建門市",
                "211147",
                "李大美",
                "0912345678",
                "oooooo@gmail.com",
                "見晴門市",
                "217477"
            ]
            ws_711.append(sample_row)

            # 填入實際資料 (第 4 列起)
            for idx, row in df_raw.iterrows():
                r_name = str(row[col_name]) if pd.notna(row[col_name]) else ""
                r_phone = str(row[col_phone]) if pd.notna(row[col_phone]) else ""
                r_email = str(row[col_email]) if (col_email != "無" and pd.notna(row[col_email])) else ""
                r_store = str(row[col_store_name]) if pd.notna(row[col_store_name]) else ""
                r_store_code = str(row[col_store_code]) if pd.notna(row[col_store_code]) else ""
                
                if col_val != "無" and pd.notna(row[col_val]):
                    try:
                        v = int(row[col_val])
                    except:
                        v = parcel_val
                else:
                    v = parcel_val

                data_row = [
                    None,
                    sender_name,
                    sender_phone,
                    sender_email,
                    v,
                    r_store,
                    r_store_code,
                    r_name,
                    r_phone,
                    r_email,
                    return_store_name,
                    return_store_code
                ]
                ws_711.append(data_row)

            # 匯出為 BytesIO 供 Streamlit 下載
            output = io.BytesIO()
            wb.save(output)
            output.seek(0)

            st.subheader("2. 預覽與下載")
            tab1, tab2 = st.tabs(["📋 整理需求清單預覽", "🚚 7-11 匯入規格預覽"])
            with tab1:
                st.dataframe(df_summary, use_container_width=True)
            with tab2:
                st.info("已自動對齊 7-11 官方說明標題與範例列，可直接上傳交貨便官網進行批次匯入。")
                
            st.download_button(
                label="📥 下載完整 7-11 兩分頁 Excel 檔",
                data=output,
                file_name="711_交貨便批次匯入與整理清單.xlsx",
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
            )

    except Exception as e:
        st.error(f"解析檔案時發生錯誤：{e}")
